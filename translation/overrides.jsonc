{
    "region.root": {
        "region.root_exits": {
            "type": "mixin",
            "el": "mixin.is_starting_age"
        }
    },
    "region.hyrule_castle_grounds": {
        "region.hc_garden": {
            "type": "value",
            "el": "item.egg"
        }
    },
    "region.child_spirit_temple_mq": {
        "logic.location.temple_spirit_mq.c_child_center": {
            "type": "and",
            "el": [
                {
                    "type": "mixin",
                    "el": "mixin.can_become_adult"
                },
                {
                    "type": "value",
                    "el": "item.hammer"
                },
                {
                    "type": "min",
                    "el": {
                        "type": "value",
                        "el": "item.key_small_spirit"
                    },
                    "value": 7
                }
            ]
        }
    },
    "region.kak_windmill": {
        "event.drain_well": {
            "type": "at",
            "node": "region.kak_windmill",
            "el": {
                "type": "and",
                "el": [
                    {
                        "type": "mixin",
                        "el": "mixin.is_child"
                    },
                    {
                        "type": "mixin",
                        "el": "function.can_play(item.song_storm)"
                    }
                ]
            }
        }
    }
}