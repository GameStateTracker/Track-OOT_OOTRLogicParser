{
    "region.root": {
        "region.root_exits": {
            "type": "mixin",
            "el": "mixin.is_starting_age"
        }
    },
    "region.hyrule_castle_grounds": {
        "region.hc_garden": {
            "type": "value",
            "el": "item.egg"
        }
    },
    "region.child_spirit_temple_mq": {
        "logic.location.temple_spirit_mq.c_child_center": {
            "type": "and",
            "el": [
                {
                    "type": "mixin",
                    "el": "mixin.can_become_adult"
                },
                {
                    "type": "value",
                    "el": "item.hammer"
                },
                {
                    "type": "min",
                    "el": {
                        "type": "value",
                        "el": "item.key_small_spirit"
                    },
                    "value": 7
                }
            ]
        }
    },
    "region.zoras_domain": {
        "event.king_zora_thawed": {
            "type": "and",
            "el": [
                {
                    "type": "mixin",
                    "el": "mixin.is_adult"
                },
                {
                    "type": "or",
                    "el": [
                        {
                            "type": "at",
                            "node": "region.ganons_castle_water_trial_mq",
                            "el": {
                                "type": "value",
                                "el": "item.bottle"
                            }
                        },
                        {
                            "type": "at",
                            "node": "region.ganons_castle_water_trial_right",
                            "el": {
                                "type": "value",
                                "el": "item.bottle"
                            }
                        },
                        {
                            "type": "at",
                            "node": "region.gerudo_training_grounds_stalfos_room_mq",
                            "el": {
                                "type": "value",
                                "el": "item.bottle"
                            }
                        },
                        {
                            "type": "at",
                            "node": "region.ice_cavern",
                            "el": {
                                "type": "value",
                                "el": "item.bottle"
                            }
                        },
                        {
                            "type": "and",
                            "el": [
                                {
                                    "type": "value",
                                    "el": "option.consider_buyable"
                                },
                                {
                                    "type": "min",
                                    "el": {
                                        "type": "value",
                                        "el": "item.wallet"
                                    },
                                    "value": 2
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "region.kak_windmill": {
        "event.drain_well": {
            "type": "at",
            "node": "region.kak_windmill",
            "el": {
                "type": "and",
                "el": [
                    {
                        "type": "mixin",
                        "el": "mixin.is_child"
                    },
                    {
                        "type": "mixin",
                        "el": "function.can_play(item.song_storm)"
                    }
                ]
            }
        }
    }
}