                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[warp_light]"
                                }
                            ]
                        },
                        {
                            "type": "value",
                            "ref": "calculated[has_all_notes_for_song(warp_light)]"
                        }
                    ]
                },
                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[song_scarecrow]"
                                }
                            ]
                        },
                        {
                            "type": "value",
                            "ref": "calculated[has_all_notes_for_song(song_scarecrow)]"
                        }
                    ]
                }
            ]
        }
