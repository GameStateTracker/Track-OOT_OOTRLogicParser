{
    /* normal songs */
    "function[has_all_notes_for_song]": {
        "params": [
            "song"
        ],
        "logic": {
            "type": "or",
            "content": [
                {
                    "type": "not",
                    "content": {
                        "type": "value",
                        "ref": "option[shuffle_individual_ocarina_notes]"
                    }
                },
                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[song_zelda]"
                                }
                            ]
                        },
                        {
                            "type": "value",
                            "ref": "calculated[has_all_notes_for_song(song_zelda)]"
                        }
                    ]
                },
                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[song_epona]"
                                }
                            ]
                        },
                        {
                            "type": "value",
