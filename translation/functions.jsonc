    /* extra songs */
    "function[can_play](item[song_scarecrow])": {
        "type": "and",
        "el": [
            {
                "type": "mixin",
                "el": "mixin[can_play_ocarina]"
            },
            {
                "type": "or",
                "el": [
                    {
                        "type": "value",
                        "el": "item[song_scarecrow]"
                    },
                    {
                        "type": "value",
                        "el": "option[free_scarecrow]"
                    }
                ]
            }
        ]
    },
    /* projectile check */
    "function[has_projectile](child)": {
        "type": "or",
        "el": [
            {
                "type": "mixin",
                "el": "mixin[has_explosives]"
            },
            {
                "type": "value",
                "el": "item[slingshot]"
            },
            {
                "type": "value",
                "el": "item[boomerang]"
            }
        ]
    },
    "function[has_projectile](adult)": {
        "type": "or",
        "el": [
            {
                "type": "mixin",
                "el": "mixin[has_explosives]"
            },
            {
                "type": "value",
                "el": "item[bow]"
            },
            {
                "type": "value",
                "el": "item[hookshot]"
            }
        ]
    },
    "function[has_projectile](both)": {
        "type": "or",
        "el": [
            {
                "type": "mixin",
                "el": "mixin[has_explosives]"
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "or",
                        "el": [
                            {
                                "type": "value",
                                "el": "item[slingshot]"
                            },
                            {
                                "type": "value",
                                "el": "item[boomerang]"
                            }
                        ]
                    },
                    {
                        "type": "or",
                        "el": [
                            {
                                "type": "value",
                                "el": "item[bow]"
                            },
                            {
                                "type": "value",
                                "el": "item[hookshot]"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "function[has_projectile](either)": {
        "type": "or",
        "el": [
            {
                "type": "mixin",
                "el": "mixin[has_explosives]"
            },
            {
                "type": "value",
                "el": "item[slingshot]"
            },
            {
                "type": "value",
                "el": "item[boomerang]"
            },
            {
                "type": "value",
                "el": "item[bow]"
            },
            {
                "type": "value",
                "el": "item[hookshot]"
            }
        ]
    },
