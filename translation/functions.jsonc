{
    /* normal songs */
    "function[has_all_notes_for_song]": {
        "params": [
            "song"
        ],
        "logic": {
            "type": "or",
            "content": [
                {
                    "type": "not",
                    "content": {
                        "type": "value",
                        "ref": "option[shuffle_individual_ocarina_notes]"
                    }
                },
                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[song_zelda]"
                                }
                            ]
                        },
                        {
                            "type": "value",
                            "ref": "calculated[has_all_notes_for_song(song_zelda)]"
                        }
                    ]
                },
                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[song_epona]"
                                }
                            ]
                        },
                        {
                            "type": "value",
                            "ref": "calculated[has_all_notes_for_song(song_epona)]"
                        }
                    ]
                },
                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[song_saria]"
                                }
                            ]
                        },
                        {
                            "type": "value",
                            "ref": "calculated[has_all_notes_for_song(song_saria)]"
                        }
                    ]
                },
                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[song_sun]"
                                }
                            ]
                        },
                        {
                            "type": "value",
                            "ref": "calculated[has_all_notes_for_song(song_sun)]"
                        }
                    ]
                },
                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[song_time]"
                                }
                            ]
                        },
                        {
                            "type": "value",
                            "ref": "calculated[has_all_notes_for_song(song_time)]"
                        }
                    ]
                },
                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[song_storm]"
                                }
                            ]
                        },
                        {
                            "type": "value",
                            "ref": "calculated[has_all_notes_for_song(song_storm)]"
                        }
                    ]
                },
                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[warp_forest]"
                                }
                            ]
                        },
                        {
                            "type": "value",
                            "ref": "calculated[has_all_notes_for_song(warp_forest)]"
                        }
                    ]
                },
                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[warp_fire]"
                                }
                            ]
                        },
                        {
                            "type": "value",
                            "ref": "calculated[has_all_notes_for_song(warp_fire)]"
                        }
                    ]
                },
                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
