                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[warp_shadow]"
                                }
                            ]
                        },
                        {
                            "type": "value",
                            "ref": "calculated[has_all_notes_for_song(warp_shadow)]"
                        }
                    ]
                },
                {
                    "type": "and",
                    "content": [
                        {
                            "type": "eq",
                            "content": [
                                {
                                    "type": "param",
                                    "ref": "song"
                                },
                                {
                                    "type": "string",
                                    "value": "item[warp_spirit]"
                                }
                            ]
                        },
                        {
                            "type": "value",
                            "ref": "calculated[has_all_notes_for_song(warp_spirit)]"
                        }
                    ]
