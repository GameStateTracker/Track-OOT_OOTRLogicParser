    /* special helpers */
    "function[has_hearts]": {
        "params": [
            "required_hearts"
        ],
        "logic": {
            "type": "gte",
            "content": [
                {
                    "type": "value",
                    "ref": "calculated[hearts_total]"
                },
                {
                    "type": "paramvalue",
                    "ref": "required_hearts"
                }
            ]
        }
    },
    "function[has_stones]": {
        "params": [
            "count"
        ],
        "logic": {
            "type": "gte",
            "content": [
                {
                    "type": "add",
                    "content": [
                        {
                            "type": "value",
                            "ref": "item[stone_forest]"
                        },
                        {
                            "type": "value",
                            "ref": "item[stone_fire]"
                        },
                        {
                            "type": "value",
                            "ref": "item[stone_water]"
                        }
                    ]
                },
                {
                    "type": "paramvalue",
                    "ref": "count"
                }
            ]
        }
    },
