    /* projectile check */
    "function[has_projectile](child)": {
        "type": "or",
        "content": [
            {
                "type": "mixin",
                "ref": "mixin[has_explosives]"
            },
            {
                "type": "value",
                "ref": "item[slingshot]"
            },
            {
                "type": "value",
                "ref": "item[boomerang]"
            }
        ]
    },
    "function[has_projectile](adult)": {
        "type": "or",
        "content": [
            {
                "type": "mixin",
                "ref": "mixin[has_explosives]"
            },
            {
                "type": "value",
                "ref": "item[bow]"
            },
            {
                "type": "value",
                "ref": "item[hookshot]"
            }
        ]
    },
    "function[has_projectile](both)": {
        "type": "or",
        "content": [
            {
                "type": "mixin",
                "ref": "mixin[has_explosives]"
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "or",
                        "content": [
                            {
                                "type": "value",
                                "ref": "item[slingshot]"
                            },
                            {
                                "type": "value",
                                "ref": "item[boomerang]"
                            }
                        ]
                    },
                    {
                        "type": "or",
                        "content": [
                            {
                                "type": "value",
                                "ref": "item[bow]"
                            },
                            {
                                "type": "value",
                                "ref": "item[hookshot]"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "function[has_projectile](either)": {
        "type": "or",
        "content": [
            {
                "type": "mixin",
                "ref": "mixin[has_explosives]"
            },
            {
                "type": "value",
                "ref": "item[slingshot]"
            },
            {
                "type": "value",
                "ref": "item[boomerang]"
            },
            {
                "type": "value",
                "ref": "item[bow]"
            },
            {
                "type": "value",
                "ref": "item[hookshot]"
            }
        ]
    },
    /* can use magic arrows */
    "function[can_use](item[arrow_fire])": {
