{
    /* normal songs */
    "function[can_play](item[song_zelda])": {
        "type": "and",
        "el": [
            {
                "type": "mixin",
                "el": "mixin[can_play_ocarina]"
            },
            {
                "type": "value",
                "el": "item[song_zelda]"
