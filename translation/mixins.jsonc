{

    /* time travel */
    "mixin.can_become_adult": {
        "type": "or",
        "el": [{
            "type": "state",
            "el": "option.starting_age",
            "value": "adult"
        }, {
            "type": "at",
            "node": "region.master_sword_pedestral",
            "el": [
                {
                    "type": "true"
                }
            ]
        }]
    },
    "mixin.can_become_child": {
        "type": "or",
        "el": [{
            "type": "state",
            "el": "option.starting_age",
            "value": "child"
        }, {
            "type": "at",
            "node": "region.master_sword_pedestral",
            "el": [
                {
                    "type": "true"
                }
            ]
        }]
    },

	"mixin.is_night": {
        "type": "state",
        "el": "filter.time",
        "value": "night"
    },
	"mixin.is_day": {
        "type": "state",
        "el": "filter.time",
        "value": "day"
    },
	
    "": ""
}
