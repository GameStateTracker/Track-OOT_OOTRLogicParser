{

    /* time travel */
    "mixin.can_become_adult": {
        "type": "or",
        "el": [{
            "type": "state",
            "el": "option.starting_age",
            "value": "adult"
        }, {
            "type": "at",
            "node": "region.master_sword_pedestral",
            "el": [
                {
                    "type": "true"
                }
            ]
        }]
    },
    "mixin.can_become_child": {
        "type": "or",
        "el": [{
            "type": "state",
            "el": "option.starting_age",
            "value": "child"
        }, {
            "type": "at",
            "node": "region.master_sword_pedestral",
            "el": [
                {
                    "type": "true"
                }
            ]
        }]
    },

	"mixin.is_night": {
        "type": "state",
        "el": "filter.time",
        "value": "night"
    },
	"mixin.is_day": {
        "type": "state",
        "el": "filter.time",
        "value": "day"
    },
	
	"mixin.jo_and_beth": {
		"type": "or",
        "el": [{
                "type": "value",
                "el": "option.ignore_poe_death_fot"
            },
            {
                "type": "or",
                "el": [{
                        "type": "and",
                        "el": [{
                                "type": "value",
                                "el": "location.temple_forest.c_poe_red",
                                "category": "location"
                            }, {
                                "type": "value",
                                "el": "location.temple_forest.c_poe_blue",
                                "category": "location"
                            }
                        ]
                    }, {
                        "type": "and",
                        "el": [{
                                "type": "value",
                                "el": "location.temple_forest_mq.c_map",
                                "category": "location"
                            }, {
                                "type": "value",
                                "el": "location.temple_forest_mq.c_compass",
                                "category": "location"
                            }]
                    }]
            }]
	},
	"mixin.amy_and_meg": {
	"type": "or",
        "el": [ {
                "type": "value",
                "el": "option.ignore_poe_death_fot"
            }, {
                    "type": "and",
                    "el": [ {
                        "type": "value",
                        "el": "location.temple_forest.k_poe_green",
                        "category": "location"
                    }, {
                        "type": "value",
                        "el": "location.temple_forest.c_poe_purple",
                        "category": "location"
                    }]
            }]
	},
    "": ""
}
