{
    /* time travel */
    "mixin.is_starting_age": { // not working correctly
        "type": "or",
        "el": [
            {
                "type": "and",
                "el": [
                    {
                        "type": "not",
                        "el": {
                            "type": "state",
                            "el": "filter.age",
                            "value": "adult"
                        }
                    },
                    {
                        "type": "state",
                        "el": "option.starting_age",
                        "value": "child"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "not",
                        "el": {
                            "type": "state",
                            "el": "filter.age",
                            "value": "child"
                        }
                    },
                    {
                        "type": "state",
                        "el": "option.starting_age",
                        "value": "adult"
                    }
                ]
            }
        ]
    },
    "mixin.can_become_adult": {
        "type": "or",
        "el": [
            {
                "type": "state",
                "el": "option.starting_age",
                "value": "adult"
            },
            {
                "type": "at",
                "node": "region.beyond_door_of_time",
                "el": {
                    "type": "true"
                }
            }
        ]
    },
    "mixin.can_become_child": {
        "type": "or",
        "el": [
            {
                "type": "state",
                "el": "option.starting_age",
                "value": "child"
            },
            {
                "type": "at",
                "node": "region.beyond_door_of_time",
                "el": {
                    "type": "true"
                }
            }
        ]
    },
    "mixin.is_child": {
        "type": "and",
        "el": [
            {
                "type": "not",
                "el": {
                    "type": "state",
                    "el": "filter.age",
                    "value": "adult"
                }
            },
            {
                "type": "mixin",
                "el": "mixin.can_become_child"
            }
        ]
    },
    "mixin.is_adult": {
        "type": "and",
        "el": [
            {
                "type": "not",
                "el": {
                    "type": "state",
                    "el": "filter.age",
                    "value": "child"
                }
            },
            {
                "type": "mixin",
                "el": "mixin.can_become_adult"
            }
        ]
    },
    "mixin.is_night": {
        "type": "not",
        "el": {
            "type": "state",
            "el": "filter.time",
            "value": "day"
        }
    },
    "mixin.is_day": {
        "type": "not",
        "el": {
            "type": "state",
            "el": "filter.time",
            "value": "night"
        }
    },
    "mixin.longshot": {
        "type": "min",
        "el": {
            "type": "value",
            "el": "item.hookshot"
        },
        "value": 2
    },
    "mixin.silver_gauntlets": {
        "type": "min",
        "el": {
            "type": "value",
            "el": "item.glove"
        },
        "value": 2
    },
    "mixin.golden_gauntlets": {
        "type": "min",
        "el": {
            "type": "value",
            "el": "item.glove"
        },
        "value": 3
    },
    "mixin.scarecrow": {
        "type": "and",
        "el": [
            {
                "type": "value",
                "el": "event.bonooru"
            },
            {
                "type": "value",
                "el": "item.hookshot"
            }
        ]
    },
    "mixin.distant_scarecrow": {
        "type": "and",
        "el": [
            {
                "type": "value",
                "el": "event.bonooru"
            },
            {
                "type": "mixin",
                "el": "mixin.longshot"
            }
        ]
    },
    "mixin.deliver_letter": {
        "type": "and",
        "el": [
            {
                "type": "mixin",
                "el": "mixin.can_become_child"
            },
            {
                "type": "value",
                "el": "item.zora_letter"
            }
        ]
    },
    "": ""
}