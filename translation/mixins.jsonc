{
    /* time travel */
    "mixin[is_starting_age]": {
        "type": "or",
        "content": [
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "content": "age",
                        "value": "child"
                    },
                    {
                        "type": "state",
                        "content": "option[starting_age]",
                        "value": "child"
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "content": "age",
                        "value": "adult"
                    },
                    {
                        "type": "state",
                        "content": "option[starting_age]",
                        "value": "adult"
                    }
                ]
            }
        ]
    },
    "mixin[can_become_adult]": {
        "type": "or",
        "content": [
            {
                "type": "state",
                "content": "option[starting_age]",
                "value": "adult"
            },
            {
                "type": "at",
                "node": "region[beyond_door_of_time]",
                "content": {
                    "type": "true"
                }
            }
        ]
    },
    "mixin[can_become_child]": {
        "type": "or",
        "content": [
            {
                "type": "state",
                "content": "option[starting_age]",
                "value": "child"
            },
            {
                "type": "at",
                "node": "region[beyond_door_of_time]",
                "content": {
                    "type": "true"
                }
            }
        ]
    },
    "mixin[filter_era]": {
        "type": "or",
        "content": [
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "content": "age",
                        "value": "child"
                    },
                    {
                        "type": "not",
                        "content": {
                            "type": "state",
                            "content": "filter[era]",
                            "value": "adult"
                        }
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "content": "age",
                        "value": "adult"
                    },
                    {
                        "type": "not",
                        "content": {
                            "type": "state",
                            "content": "filter[era]",
                            "value": "child"
                        }
                    }
                ]
            },
            {
                "type": "state",
                "content": "filter[era_apply]",
                "value": "loose"
            }
        ]
    },
    "mixin[is_child]": {
        "type": "state",
        "content": "age",
        "value": "child"
    },
    "mixin[is_adult]": {
        "type": "state",
        "content": "age",
        "value": "adult"
    },
    "mixin[is_night]": {
        "type": "not",
        "content": {
            "type": "state",
            "content": "filter[time]",
            "value": "day"
        }
    },
    "mixin[is_day]": {
        "type": "not",
        "content": {
            "type": "state",
            "content": "filter[time]",
            "value": "night"
        }
    },
    "mixin[longshot]": {
        "type": "min",
        "content": {
            "type": "value",
            "content": "item[hookshot]"
        },
        "value": 2
    },
    "mixin[silver_gauntlets]": {
        "type": "min",
        "content": {
            "type": "value",
            "content": "item[glove]"
        },
        "value": 2
    },
    "mixin[golden_gauntlets]": {
        "type": "min",
        "content": {
            "type": "value",
            "content": "item[glove]"
        },
        "value": 3
    },
    "mixin[scarecrow]": {
        "type": "and",
        "content": [
            {
                "type": "mixin",
                "content": "function[can_play](item[song_scarecrow])"
            },
            {
                "type": "value",
                "content": "item[hookshot]"
            }
        ]
    },
    "mixin[distant_scarecrow]": {
        "type": "and",
        "content": [
            {
                "type": "mixin",
                "content": "function[can_play](item[song_scarecrow])"
            },
            {
                "type": "mixin",
                "content": "mixin[longshot]"
            }
        ]
    },
    "mixin[can_build_rainbow_bridge]": {
        "type": "or",
        "content": [
            {
                "type": "state",
                "content": "option[ganon_castle_open]",
                "value": "ganon_castle_open_open"
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "content": "option[ganon_castle_open]",
                        "value": "ganon_castle_open_default"
                    },
                    {
                        "type": "value",
                        "content": "item[medallion_shadow]"
                    },
                    {
                        "type": "value",
                        "content": "item[medallion_spirit]"
                    },
                    {
                        "type": "value",
                        "content": "item[arrow_light]"
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "content": "option[ganon_castle_open]",
                        "value": "ganon_castle_open_stones"
                    },
                    {
                        "type": "mixin",
                        "content": "function[has_stones](bridge_stones)"
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "content": "option[ganon_castle_open]",
                        "value": "ganon_castle_open_medallion"
                    },
                    {
                        "type": "mixin",
                        "content": "function[has_medallions](bridge_medallions)"
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "content": "option[ganon_castle_open]",
                        "value": "ganon_castle_open_dungeon"
                    },
                    {
                        "type": "mixin",
                        "content": "function[has_dungeon_rewards](bridge_rewards)"
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "content": "option[ganon_castle_open]",
                        "value": "ganon_castle_open_skulltulas"
                    },
                    {
                        "type": "gte",
                        "content": [
                            {
                                "type": "value",
                                "content": "item[skulltula]"
                            },
                            {
                                "type": "value",
                                "content": "option[ganon_castle_skulltulas]"
                            }
                        ]
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "content": "option[ganon_castle_open]",
                        "value": "ganon_castle_open_hearts"
                    },
                    {
                        "type": "mixin",
                        "content": "function[has_hearts](ganon_bosskey_hearts)"
                    }
                ]
            }
        ]
    },
    "mixin[blue_fire]": {
        "type": "or",
        "content": [
            {
                "type": "value",
                "content": "reach_location[blue_fire]"
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "content": "option[consider_buyable]"
                    },
                    {
                        "type": "value",
                        "content": "item[bottle]"
                    },
                    {
                        "type": "min",
                        "content": {
                            "type": "value",
                            "content": "item[wallet]"
                        },
                        "value": 2
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "content": "option[blue_fire_arrows]"
                    },
                    {
                        "type": "mixin",
                        "content": "function[can_use](item[blue_fire_arrows])"
                    }
                ]
            }
        ]
    },
    "mixin[can_play_ocarina]": {
        "type": "or",
        "content": [
            {
                "type": "value",
                "content": "item[ocarina]"
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "content": "item[bottle]"
                    },
                    {
                        "type": "or",
                        "content": [
                            {
                                "type": "value",
                                "content": "option[skip.invisible_ocarina]"
                            },
                            {
                                "type": "and",
                                "content": [
                                    {
                                        "type": "value",
                                        "content": "option[skip.invisible_ocarina_midair]"
                                    },
                                    {
                                        "type": "or",
                                        "content": [
                                            {
                                                "type": "value",
                                                "content": "item[bombs]"
                                            },
                                            {
                                                "type": "value",
                                                "content": "item[bombchu]"
                                            },
                                            {
                                                "type": "and",
                                                "content": [
                                                    {
                                                        "type": "mixin",
                                                        "content": "mixin[is_child]"
                                                    },
                                                    {
                                                        "type": "or",
                                                        "content": [
                                                            {
                                                                "type": "value",
                                                                "content": "item[stick]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "content": "item[sword_kokiri]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "content": "item[slingshot]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "content": "item[boomerang]"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "and",
                                                "content": [
                                                    {
                                                        "type": "mixin",
                                                        "content": "mixin[is_adult]"
                                                    },
                                                    {
                                                        "type": "or",
                                                        "content": [
                                                            {
                                                                "type": "value",
                                                                "content": "item[sword_master]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "content": "item[sword_biggoron]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "content": "item[bow]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "content": "item[hookshot]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "content": "item[hammer]"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "mixin[is_night_gs]": {
        "type": "or",
        "content": [
            {
                "type": "and",
                "content": [
                    {
                        "type": "mixin",
                        "content": "mixin[is_night]"
                    },
                    {
                        "type": "not",
                        "content": {
                            "type": "value",
                            "content": "option[sun_song_skulltuta]"
                        }
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "content": "option[sun_song_skulltuta]"
                    },
                    {
                        "type": "mixin",
                        "content": "function[can_play](item[song_sun])"
                    }
                ]
            }
        ]
    },
    "mixin[can_leave_forest]": {
        "type": "or",
        "content": [
            {
                "type": "not",
                "content": {
                    "type": "state",
                    "content": "option[doors_open_forest]",
                    "value": "doors_open_forest_closed"
                }
            },
            {
                "type": "mixin",
                "content": "mixin[is_adult]"
            },
            {
                "type": "value",
                "content": "option[shuffle_overworld]"
            },
            {
                "type": "value",
                "content": "option[shuffle_warps]"
            },
            {
                "type": "value",
                "content": "option[shuffle_spawns]"
            },
            {
                "type": "value",
                "content": "event[deku_tree_clear]"
            }
        ]
    },
    "mixin[king_dodongo_shortcuts]": {
        "type": "and",
        "content": [
            {
                "type": "false"
            },
            {
                "type": "not",
                "content": {
                    "type": "state",
                    "content": "option[shuffle_bosses]",
                    "value": "shuffle_bosses_off"
                }
            },
            {
                "type": "or",
                "content": [
                    {
                        "type": "and",
                        "content": [
                            {
                                "type": "value",
                                "content": "option[dungeon_shortcuts.deku]"
                            },
                            {
                                "type": "state",
                                "content": " -> ",
                                "value": ""
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "mixin[has_bombchus]": {
        "type": "or",
        "content": [
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "content": "option[bombchu_logic]"
                    },
                    {
                        "type": "value",
                        "content": "item[bombchu]"
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "not",
                        "content": {
                            "type": "value",
                            "content": "option[bombchu_logic]"
                        }
                    },
                    {
                        "type": "value",
                        "content": "item[bombchu]"
                    },
                    {
                        "type": "value",
                        "content": "item[bombs]"
                    }
                ]
            }
        ]
    },
    "": ""
}