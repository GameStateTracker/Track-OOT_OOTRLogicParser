{
    /* time travel */
    "mixin[is_starting_age]": { 
        "type": "or",
        "el": [
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "age",
                        "value": "child"
                    },
                    {
                        "type": "state",
                        "el": "option[starting_age]",
                        "value": "child"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "age",
                        "value": "adult"
                    },
                    {
                        "type": "state",
                        "el": "option[starting_age]",
                        "value": "adult"
                    }
                ]
            }
        ]
    },
    "mixin[can_become_adult]": {
        "type": "or",
        "el": [
            {
                "type": "state",
                "el": "option[starting_age]",
                "value": "adult"
            },
            {
                "type": "at",
                "node": "region[beyond_door_of_time]",
                "el": {
                    "type": "true"
                }
            }
        ]
    },
    "mixin[can_become_child]": {
        "type": "or",
        "el": [
            {
                "type": "state",
                "el": "option[starting_age]",
                "value": "child"
            },
            {
                "type": "at",
                "node": "region[beyond_door_of_time]",
                "el": {
                    "type": "true"
                }
            }
        ]
    },
    "mixin[filter_era]": {
        "type": "or",
        "el": [
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "age",
                        "value": "child"
                    },
                    {
                        "type": "not",
                        "el": {
                            "type": "state",
                            "el": "filter[era]",
                            "value": "adult"
                        }
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "age",
                        "value": "adult"
                    },
                    {
                        "type": "not",
                        "el": {
                            "type": "state",
                            "el": "filter[era]",
                            "value": "child"
                        }
                    }
                ]
            },
            {
                "type": "state",
                "el": "filter[era_apply]",
                "value": "loose"
            }
        ]
    },
    "mixin[is_child]": {
        "type": "state",
        "el": "age",
        "value": "child"
    },
    "mixin[is_adult]": {
        "type": "state",
        "el": "age",
        "value": "adult"
    },
    "mixin[is_night]": {
        "type": "not",
        "el": {
            "type": "state",
            "el": "filter[time]",
            "value": "day"
        }
    },
    "mixin[is_day]": {
        "type": "not",
        "el": {
            "type": "state",
            "el": "filter[time]",
            "value": "night"
        }
    },
    "mixin[longshot]": {
        "type": "min",
        "el": {
            "type": "value",
            "el": "item[hookshot]"
        },
        "value": 2
    },
    "mixin[silver_gauntlets]": {
        "type": "min",
        "el": {
            "type": "value",
            "el": "item[glove]"
        },
        "value": 2
    },
    "mixin[golden_gauntlets]": {
        "type": "min",
        "el": {
            "type": "value",
            "el": "item[glove]"
        },
        "value": 3
    },
    "mixin[scarecrow]": {
        "type": "and",
        "el": [
            {
                "type": "mixin",
                "el": "function[can_play(item[song_scarecrow])]"
            },
            {
                "type": "value",
                "el": "item[hookshot]"
            }
        ]
    },
    "mixin[distant_scarecrow]": {
        "type": "and",
        "el": [
            {
                "type": "mixin",
                "el": "function[can_play(item[song_scarecrow])]"
            },
            {
                "type": "mixin",
                "el": "mixin[longshot]"
            }
        ]
    },
    "mixin[can_build_rainbow_bridge]": {
        "type": "or",
        "el": [
            {
                "type": "state",
                "el": "option[ganon_castle_open]",
                "value": "ganon_castle_open_open"
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option[ganon_castle_open]",
                        "value": "ganon_castle_open_default"
                    },
                    {
                        "type": "value",
                        "el": "item[medallion_shadow]"
                    },
                    {
                        "type": "value",
                        "el": "item[medallion_spirit]"
                    },
                    {
                        "type": "value",
                        "el": "item[arrow_light]"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option[ganon_castle_open]",
                        "value": "ganon_castle_open_stones"
                    },
                    {
                        "type": "mixin",
                        "el": "function[has_stones(bridge_stones)]"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option[ganon_castle_open]",
                        "value": "ganon_castle_open_medallion"
                    },
                    {
                        "type": "mixin",
                        "el": "function[has_medallions(bridge_medallions)]"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option[ganon_castle_open]",
                        "value": "ganon_castle_open_dungeon"
                    },
                    {
                        "type": "mixin",
                        "el": "function[has_dungeon_rewards(bridge_rewards)]"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option[ganon_castle_open]",
                        "value": "ganon_castle_open_skulltulas"
                    },
                    {
                        "type": "gte",
                        "el": [
                            {
                                "type": "value",
                                "el": "item[skulltula]"
                            },
                            {
                                "type": "value",
                                "el": "option[ganon_castle_skulltulas]"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "mixin[blue_fire]": {
        "type": "and",
        "el": [
            {
                "type": "value",
                "el": "item[bottle]"
            },
            {
                "type": "or",
                "el": [
                    {
                        "type": "at",
                        "node": "region[ganons_castle_water_trial_mq]",
                        "el": {
                            "type": "value",
                            "el": "item[bottle]"
                        }
                    },
                    {
                        "type": "at",
                        "node": "region[ganons_castle_water_trial]",
                        "el": {
                            "type": "value",
                            "el": "item[bottle]"
                        }
                    },
                    {
                        "type": "at",
                        "node": "region[gerudo_training_grounds_stalfos_room_mq]",
                        "el": {
                            "type": "value",
                            "el": "item[bottle]"
                        }
                    },
                    {
                        "type": "at",
                        "node": "region[ice_cavern_map_room_mq]",
                        "el": {
                            "type": "value",
                            "el": "item[bottle]"
                        }
                    },
                    {
                        "type": "and",
                        "el": [
                            {
                                "type": "at",
                                "node": "region[ice_cavern]",
                                "el": {
                                    "type": "value",
                                    "el": "item[bottle]"
                                }
                            },
                            {
                                "type": "mixin",
                                "el": "mixin[is_adult]"
                            }
                        ]
                    },
                    {
                        "type": "and",
                        "el": [
                            {
                                "type": "at",
                                "node": "region[ice_cavern_mq]",
                                "el": {
                                    "type": "value",
                                    "el": "item[bottle]"
                                }
                            },
                            {
                                "type": "mixin",
                                "el": "mixin[is_adult]"
                            }
                        ]
                    },
                    {
                        "type": "and",
                        "el": [
                            {
                                "type": "value",
                                "el": "option[consider_buyable]"
                            },
                            {
                                "type": "value",
                                "el": "item[bottle]"
                            },
                            {
                                "type": "min",
                                "el": {
                                    "type": "value",
                                    "el": "item[wallet]"
                                },
                                "value": 2
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "mixin[can_play_ocarina]": {
        "type": "or",
        "el": [
            {
                "type": "value",
                "el": "item[ocarina]"
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "value",
                        "el": "item[bottle]"
                    },
                    {
                        "type": "or",
                        "el": [
                            {
                                "type": "value",
                                "el": "option[skip.invisible_ocarina]"
                            },
                            {
                                "type": "and",
                                "el": [
                                    {
                                        "type": "value",
                                        "el": "option[skip.invisible_ocarina_midair]"
                                    },
                                    {
                                        "type": "or",
                                        "el": [
                                            {
                                                "type": "value",
                                                "el": "item[bombs]"
                                            },
                                            {
                                                "type": "value",
                                                "el": "item[bombchu]"
                                            },
                                            {
                                                "type": "and",
                                                "el": [
                                                    {
                                                        "type": "mixin",
                                                        "el": "mixin[is_child]"
                                                    },
                                                    {
                                                        "type": "or",
                                                        "el": [
                                                            {
                                                                "type": "value",
                                                                "el": "item[stick]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "el": "item[sword_kokiri]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "el": "item[slingshot]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "el": "item[boomerang]"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "and",
                                                "el": [
                                                    {
                                                        "type": "mixin",
                                                        "el": "mixin[is_adult]"
                                                    },
                                                    {
                                                        "type": "or",
                                                        "el": [
                                                            {
                                                                "type": "value",
                                                                "el": "item[sword_master]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "el": "item[sword_biggoron]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "el": "item[bow]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "el": "item[hookshot]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "el": "item[hammer]"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "mixin[is_night_gs]": {
        "type": "or",
        "el": [
            {
                "type": "and",
                "el": [
                    {
                        "type": "mixin",
                        "el": "mixin[is_night]"
                    },
                    {
                        "type": "not",
                        "el": {
                            "type": "value",
                            "el": "option[sun_song_skulltuta]"
                        }
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "value",
                        "el": "option[sun_song_skulltuta]"
                    },
                    {
                        "type": "mixin",
                        "el": "function[can_play(item[song_sun])]"
                    }
                ]
            }
        ]
    },
    "mixin[can_leave_forest]": {
        "type": "or",
        "el": [
            {
                "type": "not",
                "el": {
                    "type": "state",
                    "el": "option[doors_open_forest]",
                    "value": "doors_open_forest_closed"
                }
            },
            {
                "type": "mixin",
                "el": "mixin[is_adult]"
            },
            {
                "type": "value",
                "el": "option[shuffle_overworld]"
            },
            {
                "type": "value",
                "el": "option[shuffle_warps]"
            },
            {
                "type": "value",
                "el": "option[shuffle_spawns]"
            },
            {
                "type": "value",
                "el": "event[skip.deku_tree_clear]"
            }
        ]
    },
    "": ""
}