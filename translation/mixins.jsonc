{
    /* time travel */
    "mixin[is_day]": {
        "logic": {
            "type": "data",
            "ref": "day"
        }
    },
    "mixin[at_night]": {
        "logic": {
            "type": "data",
            "ref": "night"
        }
    },
    "mixin[at_dampe_time]": {
        "logic": {
            "type": "data",
            "ref": "dampe"
        }
    },
    "mixin[is_night_gs]": {
        "type": "or",
        "content": [
            {
                "type": "and",
                "content": [
                    {
                        "type": "mixin",
                        "ref": "mixin[at_night]"
                    },
                    {
                        "type": "not",
                        "content": {
                            "type": "value",
                            "ref": "option[sun_song_skulltuta]"
                        }
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "ref": "option[sun_song_skulltuta]"
                    },
                    {
                        "type": "function",
                        "ref": "function[can_play]",
                        "params": [
                            {
                                "type": "value",
                                "ref": "item[song_sun]"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    //---
    "mixin[fairy]": {
        "type": "or",
        "content": [
            {
                "type": "value",
                "ref": "reach_location[fairy_pot]"
            },
            {
                "type": "value",
                "ref": "reach_location[gossip_fairy]"
            },
            {
                "type": "value",
                "ref": "reach_location[bean_fairy]"
            },
            {
                "type": "value",
                "ref": "reach_location[butterfly_fairy]"
            },
            {
                "type": "value",
                "ref": "reach_location[pond_fairy]"
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "ref": "buyable[fairy]"
                    },
                    {
                        "type": "value",
                        "ref": "item[bottle]"
                    }
                ]
            }
        ]
    },
    "mixin[bugs]": {
        "type": "or",
        "content": [
            {
                "type": "value",
                "ref": "reach_location[bug_shrub]"
            },
            {
                "type": "value",
                "ref": "reach_location[bug_rock]"
            },
            {
                "type": "value",
                "ref": "reach_location[bugs_wandering]"
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "ref": "buyable[bugs]"
                    },
                    {
                        "type": "value",
                        "ref": "item[bottle]"
                    }
                ]
            }
        ]
    },
    "mixin[sticks]": {
        "type": "or",
        "content": [
            {
                "type": "value",
                "ref": "reach_location[stick_pot]"
            },
            {
                "type": "value",
                "ref": "reach_location[baba_sticks]"
            },
            {
                "type": "value",
                "ref": "buyable[sticks]"
            }
        ]
    },
    "mixin[nuts]": {
        "type": "or",
        "content": [
            {
                "type": "value",
                "ref": "reach_location[nut_pot]"
            },
            {
                "type": "value",
                "ref": "reach_location[nut_crate]"
            },
            {
                "type": "value",
                "ref": "reach_location[baba_nuts]"
            },
            {
                "type": "value",
                "ref": "buyable[nuts]"
            }
        ]
    },
    "mixin[can_play_ocarina]": {
        "type": "or",
        "content": [
            {
                "type": "value",
                "ref": "item[ocarina]"
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "ref": "item[bottle]"
                    },
                    {
                        "type": "or",
                        "content": [
                            {
                                "type": "value",
                                "ref": "option[skip.invisible_ocarina]"
                            },
                            {
                                "type": "and",
                                "content": [
                                    {
                                        "type": "value",
                                        "ref": "option[skip.invisible_ocarina_midair]"
                                    },
                                    {
                                        "type": "or",
                                        "content": [
                                            {
                                                "type": "value",
                                                "ref": "item[bombs]"
                                            },
                                            {
                                                "type": "value",
                                                "ref": "item[bombchu]"
                                            },
                                            {
                                                "type": "and",
                                                "content": [
                                                    {
                                                        "type": "mixin",
                                                        "ref": "mixin[is_child]"
                                                    },
                                                    {
                                                        "type": "or",
                                                        "content": [
                                                            {
                                                                "type": "value",
                                                                "ref": "item[stick]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "ref": "item[sword_kokiri]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "ref": "item[slingshot]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "ref": "item[boomerang]"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "and",
                                                "content": [
                                                    {
                                                        "type": "mixin",
                                                        "ref": "mixin[is_adult]"
                                                    },
                                                    {
                                                        "type": "or",
                                                        "content": [
                                                            {
                                                                "type": "value",
                                                                "ref": "item[sword_master]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "ref": "item[sword_biggoron]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "ref": "item[bow]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "ref": "item[hookshot]"
                                                            },
                                                            {
                                                                "type": "value",
                                                                "ref": "item[hammer]"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "mixin[can_leave_forest]": {
        "type": "or",
        "content": [
            {
                "type": "not",
                "content": {
                    "type": "state",
                    "ref": "option[doors_open_forest]",
                    "value": "doors_open_forest_closed"
                }
            },
            {
                "type": "mixin",
                "ref": "mixin[is_adult]"
            },
            {
                "type": "value",
                "ref": "option[shuffle_overworld]"
            },
            {
                "type": "value",
                "ref": "option[shuffle_warps]"
            },
            {
                "type": "value",
                "ref": "option[shuffle_spawns]"
            },
            {
                "type": "value",
                "ref": "event[defeat_queen_gohma]"
            }
        ]
    },
    "mixin[king_dodongo_shortcuts]": {
        "type": "value",
        "ref": "calculated[king_dodongo_shortcuts]"
    },
    "mixin[has_bombchus]": {
        "type": "or",
        "content": [
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "ref": "option[bombchu_logic]"
                    },
                    {
                        "type": "value",
                        "ref": "item[bombchu]"
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "not",
                        "content": {
                            "type": "value",
                            "ref": "option[bombchu_logic]"
                        }
                    },
                    {
                        "type": "value",
                        "ref": "item[bombchu]"
                    },
                    {
                        "type": "value",
                        "ref": "item[bombs]"
                    }
                ]
            }
        ]
    },
    "": ""
}
