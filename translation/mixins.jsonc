{
    /* time travel */
    "mixin[is_starting_age]": {
        "type": "or",
        "content": [
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "ref": "age",
                        "value": "child"
                    },
                    {
                        "type": "state",
                        "ref": "option[starting_age]",
                        "value": "child"
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "ref": "age",
                        "value": "adult"
                    },
                    {
                        "type": "state",
                        "ref": "option[starting_age]",
                        "value": "adult"
                    }
                ]
            }
        ]
    },
    "mixin[can_become_adult]": {
        "type": "or",
        "content": [
            {
                "type": "state",
                "ref": "option[starting_age]",
                "value": "adult"
            },
            {
                "type": "at",
                "node": "region[beyond_door_of_time]",
                "content": {
                    "type": "true"
                }
            }
        ]
    },
    "mixin[can_become_child]": {
        "type": "or",
        "content": [
            {
                "type": "state",
                "ref": "option[starting_age]",
                "value": "child"
            },
            {
                "type": "at",
                "node": "region[beyond_door_of_time]",
                "content": {
                    "type": "true"
                }
            }
        ]
    },
    "mixin[filter_era]": {
        "type": "or",
        "content": [
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "ref": "age",
                        "value": "child"
                    },
                    {
                        "type": "not",
                        "content": {
                            "type": "state",
                            "ref": "filter[era]",
                            "value": "adult"
                        }
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "state",
                        "ref": "age",
                        "value": "adult"
                    },
                    {
                        "type": "not",
                        "content": {
                            "type": "state",
                            "ref": "filter[era]",
                            "value": "child"
                        }
                    }
                ]
            },
            {
                "type": "state",
                "ref": "filter[era_apply]",
                "value": "loose"
            }
        ]
    },
    "mixin[is_child]": {
        "type": "state",
        "ref": "age",
        "value": "child"
    },
    "mixin[is_adult]": {
        "type": "state",
        "ref": "age",
        "value": "adult"
    },
    "mixin[is_night]": {
        "type": "not",
        "content": {
            "type": "state",
            "ref": "filter[time]",
            "value": "day"
        }
    },
    "mixin[is_day]": {
        "type": "not",
        "content": {
            "type": "state",
            "ref": "filter[time]",
            "value": "night"
        }
    },
    "mixin[blue_fire]": {
        "type": "or",
        "content": [
            {
                "type": "value",
                "ref": "reach_location[blue_fire]"
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "ref": "buyable[blue_fire]"
                    },
                    {
                        "type": "value",
                        "ref": "item[bottle]"
                    },
                    {
                        "type": "min",
                        "content": {
                            "type": "value",
                            "ref": "item[wallet]"
                        },
                        "value": 2
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "ref": "option[blue_fire_arrows]"
                    },
                    {
                        "type": "function",
                        "ref": "function[can_use]",
                        "params": [
                            {
                                "type": "string",
                                "value": "item[arrow_ice]"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "mixin[fish]": {
        "type": "or",
        "content": [
            {
                "type": "value",
                "ref": "reach_location[fish_lone]"
            },
            {
                "type": "value",
                "ref": "reach_location[fish_group]"
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "ref": "buyable[fish]"
                    },
                    {
                        "type": "value",
                        "ref": "item[bottle]"
                    },
                    {
                        "type": "min",
                        "content": {
                            "type": "value",
                            "ref": "item[wallet]"
                        },
                        "value": 1
                    }
                ]
            }
        ]
    },
    "mixin[fairy]": {
        "type": "or",
        "content": [
            {
                "type": "value",
                "ref": "reach_location[fairy_pot]"
            },
            {
                "type": "value",
                "ref": "reach_location[gossip_fairy]"
            },
            {
                "type": "value",
                "ref": "reach_location[bean_fairy]"
            },
            {
                "type": "value",
                "ref": "reach_location[butterfly_fairy]"
            },
            {
                "type": "value",
                "ref": "reach_location[pond_fairy]"
            },
            {
                "type": "value",
                "ref": "reach_location[bombable_fairy]"
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "ref": "buyable[fairy]"
                    },
                    {
                        "type": "value",
                        "ref": "item[bottle]"
                    }
                ]
            }
        ]
    },
    "mixin[bugs]": {
        "type": "or",
        "content": [
            {
                "type": "value",
                "ref": "reach_location[bug_shrub]"
            },
            {
                "type": "value",
                "ref": "reach_location[bug_rock]"
            },
            {
                "type": "value",
                "ref": "reach_location[bugs_wandering]"
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "ref": "buyable[bugs]"
                    },
                    {
                        "type": "value",
                        "ref": "item[bottle]"
                    }
                ]
            }
        ]
    },
    "mixin[sticks]": {
        "type": "or",
        "content": [
            {
                "type": "value",
                "ref": "reach_location[stick_pot]"
            },
            {
                "type": "value",
                "ref": "reach_location[baba_sticks]"
            },
            {
                "type": "value",
                "ref": "buyable[sticks]"
            }
        ]
    },
    "mixin[nuts]": {
        "type": "or",
        "content": [
            {
                "type": "value",
                "ref": "reach_location[nut_pot]"
            },
            {
                "type": "value",
                "ref": "reach_location[nut_crate]"
            },
            {
                "type": "value",
                "ref": "reach_location[baba_nuts]"
            },
            {
                "type": "value",
                "ref": "buyable[nuts]"
            }
        ]
    },
    "mixin[is_night_gs]": {
        "type": "or",
        "content": [
            {
                "type": "and",
                "content": [
                    {
                        "type": "mixin",
                        "ref": "mixin[is_night]"
                    },
                    {
                        "type": "not",
                        "content": {
                            "type": "value",
                            "ref": "option[sun_song_skulltuta]"
                        }
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "ref": "option[sun_song_skulltuta]"
                    },
                    {
                        "type": "function",
                        "ref": "function[can_play]",
                        "params": [
                            {
                                "type": "string",
                                "value": "item[song_sun]"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "mixin[king_dodongo_shortcuts]": {
        "type": "value",
        "ref": "calculated[king_dodongo_shortcuts]"
    },
    "mixin[has_bombchus]": {
        "type": "or",
        "content": [
            {
                "type": "and",
                "content": [
                    {
                        "type": "value",
                        "ref": "option[bombchu_logic]"
                    },
                    {
                        "type": "value",
                        "ref": "item[bombchu]"
                    }
                ]
            },
            {
                "type": "and",
                "content": [
                    {
                        "type": "not",
                        "content": {
                            "type": "value",
                            "ref": "option[bombchu_logic]"
                        }
                    },
                    {
                        "type": "value",
                        "ref": "item[bombchu]"
                    },
                    {
                        "type": "value",
                        "ref": "item[bombs]"
                    }
                ]
            }
        ]
    },
    "": ""
}
