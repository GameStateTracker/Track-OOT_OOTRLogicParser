{
    /* time travel */
    "mixin.is_starting_age": { 
        "type": "or",
        "el": [
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "age",
                        "value": "child"
                    },
                    {
                        "type": "state",
                        "el": "option.starting_age",
                        "value": "child"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "age",
                        "value": "adult"
                    },
                    {
                        "type": "state",
                        "el": "option.starting_age",
                        "value": "adult"
                    }
                ]
            }
        ]
    },
    "mixin.can_become_adult": {
        "type": "or",
        "el": [
            {
                "type": "state",
                "el": "option.starting_age",
                "value": "adult"
            },
            {
                "type": "at",
                "node": "region.beyond_door_of_time",
                "el": {
                    "type": "true"
                }
            }
        ]
    },
    "mixin.can_become_child": {
        "type": "or",
        "el": [
            {
                "type": "state",
                "el": "option.starting_age",
                "value": "child"
            },
            {
                "type": "at",
                "node": "region.beyond_door_of_time",
                "el": {
                    "type": "true"
                }
            }
        ]
    },
    "mixin.is_child": {
        "type": "state",
        "el": "age",
        "value": "child"
    },
    "mixin.is_adult": {
        "type": "state",
        "el": "age",
        "value": "adult"
    },
    "mixin.is_night": {
        "type": "not",
        "el": {
            "type": "state",
            "el": "filter.time",
            "value": "day"
        }
    },
    "mixin.is_day": {
        "type": "not",
        "el": {
            "type": "state",
            "el": "filter.time",
            "value": "night"
        }
    },
    "mixin.longshot": {
        "type": "min",
        "el": {
            "type": "value",
            "el": "item.hookshot"
        },
        "value": 2
    },
    "mixin.silver_gauntlets": {
        "type": "min",
        "el": {
            "type": "value",
            "el": "item.glove"
        },
        "value": 2
    },
    "mixin.golden_gauntlets": {
        "type": "min",
        "el": {
            "type": "value",
            "el": "item.glove"
        },
        "value": 3
    },
    "mixin.scarecrow": {
        "type": "and",
        "el": [
            {
                "type": "mixin",
                "el": "function.can_play(item.song_scarecrow)"
            },
            {
                "type": "value",
                "el": "item.hookshot"
            }
        ]
    },
    "mixin.distant_scarecrow": {
        "type": "and",
        "el": [
            {
                "type": "mixin",
                "el": "function.can_play(item.song_scarecrow)"
            },
            {
                "type": "mixin",
                "el": "mixin.longshot"
            }
        ]
    },
    "mixin.deliver_letter": {
        "type": "and",
        "el": [
            {
                "type": "mixin",
                "el": "mixin.can_become_child"
            },
            {
                "type": "value",
                "el": "item.zora_letter"
            }
        ]
    },
    "mixin.can_build_rainbow_bridge[adult]": {
        "type": "or",
        "el": [
            {
                "type": "state",
                "el": "option.ganon_castle_open",
                "value": "ganon_castle_open_open"
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option.ganon_castle_open",
                        "value": "ganon_castle_open_default"
                    },
                    {
                        "type": "value",
                        "el": "item.medallion_shadow"
                    },
                    {
                        "type": "value",
                        "el": "item.medallion_spirit"
                    },
                    {
                        "type": "value",
                        "el": "item.arrow_light"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option.ganon_castle_open",
                        "value": "ganon_castle_open_stones"
                    },
                    {
                        "type": "mixin",
                        "el": "function.has_stones(bridge_stones)[adult]"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option.ganon_castle_open",
                        "value": "ganon_castle_open_medallion"
                    },
                    {
                        "type": "mixin",
                        "el": "function.has_medallions(bridge_medallions)[adult]"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option.ganon_castle_open",
                        "value": "ganon_castle_open_dungeon"
                    },
                    {
                        "type": "mixin",
                        "el": "function.has_dungeon_rewards(bridge_rewards)[adult]"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option.ganon_castle_open",
                        "value": "ganon_castle_open_skulltulas"
                    },
                    {
                        "type": "gte",
                        "el": [
                            {
                                "type": "value",
                                "el": "item.skulltula"
                            },
                            {
                                "type": "value",
                                "el": "option.ganon_castle_skulltulas"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "mixin.can_trigger_lacs": {
        "type": "or",
        "el": [
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option.light_arrow_cutscene",
                        "value": "light_arrow_cutscene_vanilla"
                    },
                    {
                        "type": "value",
                        "el": "item.medallion_shadow"
                    },
                    {
                        "type": "value",
                        "el": "item.medallion_spirit"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option.light_arrow_cutscene",
                        "value": "light_arrow_cutscene_stones"
                    },
                    {
                        "type": "mixin",
                        "el": "function.has_stones(lacs_stones)"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option.light_arrow_cutscene",
                        "value": "light_arrow_cutscene_medallions"
                    },
                    {
                        "type": "mixin",
                        "el": "function.has_medallions(lacs_medallions)"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option.light_arrow_cutscene",
                        "value": "light_arrow_cutscene_dungeons"
                    },
                    {
                        "type": "mixin",
                        "el": "function.has_dungeon_rewards(lacs_rewards)"
                    }
                ]
            },
            {
                "type": "and",
                "el": [
                    {
                        "type": "state",
                        "el": "option.light_arrow_cutscene",
                        "value": "light_arrow_cutscene_skulltulas"
                    },
                    {
                        "type": "gte",
                        "el": [
                            {
                                "type": "value",
                                "el": "item.skulltula"
                            },
                            {
                                "type": "value",
                                "el": "option.lacs_skulltulas"
                            }
                        ]
                    }
                ]
            }
        ]
    },

    "mixin.blue_fire": {
        "type": "and",
        "el": [
            {
                "type": "value",
                "el": "item.bottle"
            },
            {
                "type": "or",
                "el": [
                    {
                        "type": "at",
                        "node": "region.ganons_castle_water_trial_mq",
                        "el": {
                            "type": "true"
                        }
                    },
                    {
                        "type": "at",
                        "node": "region.ganons_castle_water_trial",
                        "el": {
                            "type": "true"
                        }
                    },
                    {
                        "type": "at",
                        "node": "region.gerudo_training_grounds_stalfos_room_mq",
                        "el": {
                            "type": "true"
                        }
                    },
                    {
                        "type": "at",
                        "node": "region.ice_cavern_map_room_mq",
                        "el": {
                            "type": "true"
                        }
                    },
                    {
                        "type": "and",
                        "el": [
                            {
                                "type": "at",
                                "node": "region.ice_cavern",
                                "el": {
                                    "type": "true"
                                }
                            },
                            {
                                "type": "mixin",
                                "el": "mixin.is_adult"
                            }
                        ]
                    },
                    {
                        "type": "and",
                        "el": [
                            {
                                "type": "value",
                                "el": "option.consider_buyable"
                            },
                            {
                                "type": "min",
                                "el": {
                                    "type": "value",
                                    "el": "item.wallet"
                                },
                                "value": 2
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "": ""
}