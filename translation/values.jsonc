{
    /* temporary override */
    "Time_Travel": {
        "type": "true"
    },
    "is_starting_age": {
        "type": "true"
    },
    /* mixins */
    "is_child": {
        "type": "value",
        "el": "mixin.can_become_child"
    },
    "is_adult": {
        "type": "value",
        "el": "mixin.can_become_adult"
    },
    "at_night": {
        "type": "value",
        "el": "mixin.is_night"
    },
    "at_day": {
        "type": "value",
        "el": "mixin.is_day"
    },
    "Forest_Temple_Jo_and_Beth": {
        "type": "value",
        "el": "mixin.jo_and_beth"
    },
    "Forest_Temple_Amy_and_Meg": {
        "type": "value",
        "el": "mixin.amy_and_meg"
    },
    "at_dampe_time": {
        "type": "value",
        "el": "mixin.is_night"
    },
    /* specials */
    "Showed_Mido_Sword_&_Shield": {
        "type": "and",
        "el": [
            {
                "type": "value",
                "el": "item.sword_kokiri"
            },
            {
                "type": "value",
                "el": "item.shield_kokiri"
            }
        ]
    },
    "Drain_Well": {
        "type": "and",
        "el": [
            {
                "type": "value",
                "el": "mixin.can_become_child"
            },
            {
                "type": "value",
                "el": "function.can_play(item.song_storm)"
            }
        ]
    },
    "GC_Woods_Warp_Open": {
        "type": "and",
        "el": [
            {
                "type": "value",
                "el": "mixin.can_blast_or_smash"
            },
            {
                "type": "value",
                "el": "function.can_use(item.magic_din)"
            }
        ]
    },
    "Goron_City_Child_Fire": {
        "type": "and",
        "el": [
            {
                "type": "value",
                "el": "mixin.can_become_child"
            },
            {
                "type": "value",
                "el": "function.can_use(item.magic_din)"
            }
        ]
    },
    "Stop_GC_Rolling_Goron_as_Adult": {
        "type": "and",
        "el": [
            {
                "type": "value",
                "el": "mixin.can_become_adult"
            },
            {
                "type": "value",
                "el": "item.glove"
            },
            {
                "type": "or",
                "el": [
                    {
                        "type": "value",
                        "el": "mixin.has_explosives"
                    },
                    {
                        "type": "value",
                        "el": "item.bow"
                    },
                    {
                        "type": "and",
                        "el": [
                            {
                                "type": "value",
                                "el": "skip.linkthegoron_dins"
                            },
                            {
                                "type": "value",
                                "el": "function.can_use(item.magic_din)"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "Child_Water_Temple": {
        "type": "value",
        "el": "mixin.can_become_child"
    },
    "had_night_start": {
        "type": "value",
        "el": "option.time_start_night"
    },
    "Links_Cow": {
        "type": "and",
        "el": [
            {
                "type": "value",
                "el": "function.can_play(item.song_epona"
            },
            {
                "type": "value",
                "el": "mixin.can_become_adult"
            },
            {
                "type": "value",
                "el": "mixin.is_day"
            }
        ]
    },
    "Epona": {
        "type": "value",
        "el": "event.epona"
    },
    "Bonooru": {
